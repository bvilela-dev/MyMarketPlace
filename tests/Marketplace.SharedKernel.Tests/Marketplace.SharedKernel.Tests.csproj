<Project Sdk="Microsoft.NET.Sdk">

  <!-- Testes dos blocos de dominio compartilhados (Result, ValueObject, Entity). -->

  <ItemGroup>
    <!--
      xUnit v3 traz o proprio runner (Microsoft.Testing.Platform), entao nao precisa
      de Microsoft.NET.Test.Sdk nem do adaptador do VSTest — que, alias, deixou de
      ser suportado pelo `dotnet test` a partir do SDK do .NET 10.
    -->
    <PackageReference Include="xunit.v3" />
    <!-- Dubles de teste (mocks/stubs) para isolar o codigo sob teste. -->
    <PackageReference Include="NSubstitute" />
    <!-- Asserts legiveis; BSD, sem a restricao de licenca comercial do FluentAssertions 8. -->
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\BuildingBlocks\Marketplace.SharedKernel\Marketplace.SharedKernel.csproj" />
  </ItemGroup>

</Project>
