<Project Sdk="Microsoft.NET.Sdk">

  <!-- Testes da maquina de estados do pedido e do caso de uso de criacao. -->

  <ItemGroup>
    <!--
      xUnit v3 traz o proprio runner (Microsoft.Testing.Platform), entao nao precisa
      de Microsoft.NET.Test.Sdk nem do adaptador do VSTest — que, alias, deixou de
      ser suportado pelo `dotnet test` a partir do SDK do .NET 10.
    -->
    <PackageReference Include="xunit.v3" />
    <!-- Dubles de teste (mocks/stubs) para isolar o codigo sob teste. -->
    <PackageReference Include="NSubstitute" />
    <!-- Asserts legiveis; BSD, sem a restricao de licenca comercial do FluentAssertions 8. -->
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Order\Order.Application\Order.Application.csproj" />
    <ProjectReference Include="..\..\Order\Order.Domain\Order.Domain.csproj" />
    <!-- O OrderDbContext (infraestrutura) e usado com o provider InMemory para testar
         o caso de uso de ponta a ponta dentro do processo, sem Postgres. -->
    <ProjectReference Include="..\..\Order\Order.Infrastructure\Order.Infrastructure.csproj" />
  </ItemGroup>

</Project>
