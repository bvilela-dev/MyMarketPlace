<Project>
  <!--
    Gerenciamento centralizado de versoes (Central Package Management).

    Por que isso existe:
      - Cada .csproj declara apenas <PackageReference Include="X" /> (sem Version).
      - A versao real fica *somente* aqui, garantindo que os 30+ projetos da solucao
        nunca fiquem com versoes divergentes do mesmo pacote (o classico "diamond
        dependency problem", que gera MethodNotFoundException apenas em runtime).
      - Atualizar uma dependencia passa a ser a alteracao de uma unica linha.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- ==================== Aplicacao / Dominio ==================== -->
  <ItemGroup>
    <!-- Hash de senha com fator de custo adaptativo (resistente a forca bruta em GPU). -->
    <PackageVersion Include="BCrypt.Net-Next" Version="4.0.3" />
    <!-- Validacao declarativa dos comandos/queries, plugada no pipeline do MediatR. -->
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="11.11.0" />
    <!--
      MediatR fixado na 12.x de proposito: a partir da 13.x o projeto passou a exigir
      licenca comercial. Manter a 12.4.1 mantem o repositorio livre para uso publico.
    -->
    <PackageVersion Include="MediatR" Version="12.4.1" />
  </ItemGroup>

  <!-- ==================== Mensageria ==================== -->
  <ItemGroup>
    <!--
      MassTransit fixado na 8.x pelo mesmo motivo do MediatR: a linha 9.x mudou o
      modelo de licenciamento. A 8.5.1 cobre tudo que o projeto demonstra
      (retry, circuit breaker, consumers, test harness em memoria).
    -->
    <PackageVersion Include="MassTransit" Version="8.5.1" />
    <PackageVersion Include="MassTransit.RabbitMQ" Version="8.5.1" />
  </ItemGroup>

  <!-- ==================== gRPC ==================== -->
  <ItemGroup>
    <PackageVersion Include="Google.Protobuf" Version="3.28.3" />
    <PackageVersion Include="Grpc.AspNetCore" Version="2.71.0" />
    <PackageVersion Include="Grpc.Net.ClientFactory" Version="2.71.0" />
    <PackageVersion Include="Grpc.Tools" Version="2.71.0" />
  </ItemGroup>

  <!-- ==================== Persistencia ==================== -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.11" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="StackExchange.Redis" Version="2.8.37" />
  </ItemGroup>

  <!-- ==================== Web / API ==================== -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <!-- Resiliencia (retry + circuit breaker) para as chamadas HTTP/gRPC de saida. -->
    <PackageVersion Include="Microsoft.Extensions.Http.Polly" Version="10.0.0" />
    <PackageVersion Include="Polly.Extensions.Http" Version="3.0.0" />
    <!--
      Swashbuckle traz a sua propria versao de Microsoft.OpenApi. Referenciar o
      Microsoft.OpenApi diretamente (como era feito antes) prendia a solucao numa
      versao 2.3.0 com vulnerabilidade conhecida (GHSA-v5pm-xwqc-g5wc).
    -->
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <!-- Reverse proxy do API Gateway. -->
    <PackageVersion Include="Yarp.ReverseProxy" Version="2.3.0" />
  </ItemGroup>

  <!-- ==================== Observabilidade ==================== -->
  <ItemGroup>
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.17.0" />
  </ItemGroup>

  <!-- ==================== Testes ==================== -->
  <ItemGroup>
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <!-- Test double library: usada para isolar handlers das dependencias externas. -->
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <!--
      Shouldly no lugar do FluentAssertions: a partir da v8 o FluentAssertions passou
      a exigir licenca paga para uso comercial. Shouldly (BSD) oferece asserts com a
      mesma legibilidade sem restricao de licenca.
    -->
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>
</Project>
