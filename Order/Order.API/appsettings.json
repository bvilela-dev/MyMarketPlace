{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5434;Database=orderdb;Username=postgres;Password=postgres",
    "RabbitMq": "rabbitmq://guest:guest@localhost:5672"
  },
  "Grpc": {
    "Catalog": "http://localhost:5201",
    "Identity": "http://localhost:5101"
  },
  "Jwt": {
    "Issuer": "marketplace.identity",
