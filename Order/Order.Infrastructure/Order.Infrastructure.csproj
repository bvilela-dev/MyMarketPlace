<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Camada de infraestrutura do Order: Postgres, clientes gRPC resilientes e outbox.
  -->

  <ItemGroup>
    <ProjectReference Include="..\Order.Application\Order.Application.csproj" />
    <ProjectReference Include="..\Order.Domain\Order.Domain.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\Marketplace.Contracts\Marketplace.Contracts.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\Marketplace.Infrastructure\Marketplace.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Net.ClientFactory" />
    <PackageReference Include="Grpc.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Http.Polly" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Polly.Extensions.Http" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Os .proto sao COMPARTILHADOS por link, sem referencia de projeto: o Order gera
      apenas os stubs de CLIENTE a partir do mesmo arquivo que o servidor usa.
      Assim o contrato tem uma unica fonte de verdade e uma quebra aparece em tempo
      de compilacao, nao em producao.

      Em um cenario real com times separados, estes .proto viveriam num repositorio
      de contratos versionado e distribuido como pacote NuGet.
    -->
    <Protobuf Include="..\..\Catalog\Catalog.API\Protos\catalog.proto" GrpcServices="Client" Link="Protos\catalog.proto" />
    <Protobuf Include="..\..\Identity\Identity.API\Protos\identity.proto" GrpcServices="Client" Link="Protos\identity.proto" />
  </ItemGroup>

</Project>
