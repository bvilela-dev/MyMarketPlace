{
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://+:5200",
        "Protocols": "Http1AndHttp2"
      },
      "Grpc": {
        "Url": "http://+:5201",
        "Protocols": "Http2"
      }
    }
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5433;Database=catalogdb;Username=postgres;Password=postgres",
    "Redis": "localhost:6379",
    "RabbitMq": "rabbitmq://guest:guest@localhost:5672"
  },
  "Jwt": {
    "Issuer": "marketplace.identity",
    "Audience": "marketplace.clients",
    "Secret": "dev-only-secret-change-me-at-least-32-bytes-long",
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeDays": 30
  },
  "Seed": {
    "Enabled": true
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "http://localhost:4317"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
