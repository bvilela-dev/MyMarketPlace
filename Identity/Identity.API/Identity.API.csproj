<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Camada de apresentacao do Identity: controllers REST, servico gRPC e o
    Program.cs que monta o host. Nao contem regra de negocio.
  -->

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="MassTransit" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Identity.Application\Identity.Application.csproj" />
    <ProjectReference Include="..\Identity.Infrastructure\Identity.Infrastructure.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\Marketplace.Infrastructure\Marketplace.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- GrpcServices="Server": gera apenas a classe base do servico. O stub de cliente
         e gerado no Order, a partir do mesmo .proto. -->
    <Protobuf Include="Protos\identity.proto" GrpcServices="Server" />
  </ItemGroup>

</Project>
