              ],
              "path": [
                "identity",
                "api",
                "auth",
                "login"
              ]
            },
            "description": "A mensagem e identica a de usuario inexistente — evita enumeracao de contas.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"bruno.demo@teste.com\",\n  \"password\": \"senha-errada\"\n}"
            },
            "auth": {
