        {
          "name": "Renovar token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gateway}}/identity/api/auth/refresh",
              "host": [
                "{{gateway}}"
              ],
              "path": [
                "identity",
                "api",
                "auth",
                "refresh"
              ]
            },
            "description": "Rotacao: o refresh token apresentado e revogado e um novo par e emitido.\nRodar esta requisicao duas vezes seguidas resulta em 401 na segunda.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('token realmente rotacionado', () => pm.expect(body.refreshToken).to.not.eql(pm.collectionVariables.get('refreshToken')));",
                  "pm.collectionVariables.set('accessToken', body.accessToken);",
                  "pm.collectionVariables.set('refreshToken', body.refreshToken);"
                ]
              }
            }
          ]
        },
