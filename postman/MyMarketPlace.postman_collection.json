    {
      "name": "4. Carrinho",
      "description": "Carrinho completo em Redis, com TTL de 7 dias.",
      "item": [
        {
          "name": "Gravar carrinho",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gateway}}/cart/api/carts/me",
              "host": [
                "{{gateway}}"
              ],
              "path": [
                "cart",
                "api",
                "carts",
                "me"
              ]
            },
            "description": "PUT porque substitui o recurso inteiro e e idempotente: reenviar o mesmo\ncorpo leva sempre ao mesmo estado final.\nNote que ha DUAS linhas do mesmo produto — o dominio as consolida em uma.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"name\": \"Produto\",\n      \"unitPrice\": 279.9,\n      \"quantity\": 1\n    },\n    {\n      \"productId\": \"{{productId}}\",\n      \"name\": \"Produto\",\n      \"unitPrice\": 279.9,\n      \"quantity\": 1\n    }\n  ]\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('itens repetidos foram consolidados', () => pm.expect(body.items.length).to.eql(1));",
                  "pm.test('quantidade somada', () => pm.expect(body.items[0].quantity).to.eql(2));"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar carrinho",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway}}/cart/api/carts/me",
