                "{{gateway}}"
              ],
              "path": [
                "identity",
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Mesmo e-mail com caixa diferente. Antes da correcao, isso passava pela checagem\ne estourava violacao de indice unico no Postgres (HTTP 500). Agora responde 409.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Outro\",\n  \"email\": \"BRUNO.DEMO@Teste.com\",\n  \"password\": \"outra-senha-123\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 Conflict', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "Cadastro invalido (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gateway}}/identity/api/auth/register",
              "host": [
                "{{gateway}}"
              ],
              "path": [
                "identity",
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Resposta em application/problem+json (RFC 9457) com TODOS os campos invalidos de uma vez.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\",\n  \"email\": \"nao-e-email\",\n  \"password\": \"123\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "const body = pm.response.json();",
                  "pm.test('lista os campos invalidos', () => pm.expect(Object.keys(body.errors).length).to.be.above(2));",
                  "pm.test('inclui traceId', () => pm.expect(body).to.have.property('traceId'));"
                ]
              }
            }
          ]
        },
