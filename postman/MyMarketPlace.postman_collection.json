                "cart",
                "api",
                "carts",
                "me"
              ]
            },
            "description": "Le do Redis. O total e calculado, nunca armazenado.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
